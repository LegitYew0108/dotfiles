{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

zsh_path="$(command -v zsh || true)"
if [ -z "$zsh_path" ]; then
  echo "[chezmoi] zsh not found; skipping chsh"
  exit 0
fi

current_shell="$(getent passwd "$USER" | cut -d: -f7 || true)"
if [ -n "$current_shell" ] && [ "$(realpath -m "$current_shell")" = "$(realpath -m "$zsh_path")" ]; then
  exit 0
fi

# Use sudo chsh to reuse sudo credentials instead of prompting separately via PAM
if sudo chsh -s "$zsh_path" "$USER"; then
  echo "[chezmoi] Changed login shell for $USER to $zsh_path"
else
  echo "[chezmoi] WARNING: could not change login shell automatically. Run: chsh -s $zsh_path" >&2
fi
{{- end }}
