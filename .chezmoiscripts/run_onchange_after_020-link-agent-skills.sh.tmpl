#!/usr/bin/env bash
set -euo pipefail

# Trigger re-run whenever the set of skill directories in dotfiles changes:
{{- range (glob (joinPath .chezmoi.sourceDir "dot_agents/skills/*")) }}
# - {{ base . }}
{{- end }}

SRC_DIR="$HOME/.agents/skills"
TARGETS=(
  "$HOME/.claude/skills"
  "$HOME/.gemini/config/skills"
  "$HOME/.copilot/skills"
)

if [ ! -d "$SRC_DIR" ]; then
  exit 0
fi

for target_dir in "${TARGETS[@]}"; do
  mkdir -p "$target_dir"

  # Remove stale symlinks pointing into ~/.agents/skills that no longer exist
  for entry in "$target_dir"/*; do
    [ -L "$entry" ] || continue
    link_target="$(readlink "$entry" || true)"
    case "$link_target" in
      "$SRC_DIR"/*)
        if [ ! -e "$entry" ]; then
          rm -f "$entry"
        fi
        ;;
    esac
  done

  # Symlink each skill directory individually (preserves existing dirs like ~/.claude/skills/synced)
  for skill_dir in "$SRC_DIR"/*/; do
    [ -d "$skill_dir" ] || continue
    skill_name="$(basename "$skill_dir")"
    dest="$target_dir/$skill_name"
    if [ -e "$dest" ] && [ ! -L "$dest" ]; then
      echo "Skipping $dest (exists and is not a symlink)" >&2
      continue
    fi
    ln -sfn "${skill_dir%/}" "$dest"
  done
done
